     "text": [
      "<class 'pandas.DataFrame'>\n",
      "RangeIndex: 32791 entries, 0 to 32790\n",
      "Data columns (total 3 columns):\n",
      " #   Column              Non-Null Count  Dtype  \n",
      "---  ------              --------------  -----  \n",
      " 0   client_id           32791 non-null  int64  \n",
      " 1   Variation           32791 non-null  str    \n",
      " 2   completion_minutes  32791 non-null  float64\n",
      "dtypes: float64(1), int64(1), str(1)\n",
      "memory usage: 768.7 KB\n"
    "def holm(p_values):\n",
    "    \"\"\"Holm-Bonferroni adjusted p-values.\"\"\"\n",
    "    p = np.asarray(p_values, dtype=float)\n",
    "    order = np.argsort(p)\n",
    "    n = len(p)\n",
    "    adjusted = np.empty(n)\n",
    "    running_max = 0.0\n",
    "    for rank, idx in enumerate(order):\n",
    "        value = (n - rank) * p[idx]\n",
    "        running_max = max(running_max, value)\n",
    "        adjusted[idx] = min(running_max, 1.0)\n",
    "    return adjusted\n",
    "\n",
    "\n",
    "results[\"p_adjusted\"] = holm(results[\"p_value\"])\n",
    "results[\"significant\"] = results[\"p_adjusted\"] < ALPHA\n",
    "results"
   ]
  },
  {
