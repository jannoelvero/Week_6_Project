      "Critical value: -1.6449\n",
      "Alpha: 0.05\n"
     ]
    }
   ],
   "source": [
    "# Standardized Mann Whitney U statistic\n",
    "\n",
    "import numpy as np\n",
    "from scipy.stats import norm\n",
    "\n",
    "n_test = len(test_navigation)\n",
    "n_control = len(control_navigation)\n",
    "\n",
    "u_mean = (n_test * n_control) / 2\n",
    "\n",
    "u_std = np.sqrt(\n",
    "    (n_test * n_control * (n_test + n_control + 1)) / 12\n",
    ")\n",
    "\n",
    "z_stat = (u_stat - u_mean) / u_std\n",
    "\n",
    "alpha = 0.05\n",
    "z_critical = norm.ppf(alpha)\n",
    "\n",
    "print(f\"Z statistic: {z_stat:.4f}\")\n",
    "print(f\"Critical value: {z_critical:.4f}\")\n",
    "print(f\"Alpha: {alpha}\")"
   ]
  },
