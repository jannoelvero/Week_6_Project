    "# One tailed two proportion Z test\n",
    "\n",
    "from statsmodels.stats.proportion import proportions_ztest\n",
    "\n",
    "test_step_back = step_back_summary.loc[\"Test\", \"sum\"]\n",
    "control_step_back = step_back_summary.loc[\"Control\", \"sum\"]\n",
    "\n",
    "test_total = step_back_summary.loc[\"Test\", \"count\"]\n",
    "control_total = step_back_summary.loc[\"Control\", \"count\"]\n",
    "\n",
    "count = [test_step_back, control_step_back]\n",
    "nobs = [test_total, control_total]\n",
    "\n",
    "z_stat, p_value = proportions_ztest(\n",
    "    count,\n",
    "    nobs,\n",
    "    alternative=\"larger\"\n",
    ")\n",
    "\n",
    "alpha = 0.05\n",
    "\n",
    "print(f\"Z statistic: {z_stat:.4f}\")\n",
    "print(f\"P value: {p_value:.6f}\")\n",
    "print(f\"Alpha: {alpha}\")"
