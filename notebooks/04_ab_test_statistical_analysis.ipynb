   "source": [
    "# Critical value visualization for RQ2\n",
    "\n",
    "alpha = 0.05\n",
    "critical_value = norm.ppf(1 - alpha)\n",
    "\n",
    "x = np.linspace(-4, 19, 1000)\n",
    "y = norm.pdf(x)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "# Standard normal distribution\n",
    "plt.plot(x, y)\n",
    "\n",
    "# Rejection region\n",
    "x_reject = x[x >= critical_value]\n",
    "y_reject = norm.pdf(x_reject)\n",
    "\n",
    "plt.fill_between(\n",
    "    x_reject,\n",
    "    y_reject,\n",
    "    alpha=0.3,\n",
    "    label=\"Rejection Region\"\n",
    ")\n",
    "\n",
    "# Critical value\n",
    "plt.axvline(\n",
    "    critical_value,\n",
    "    linestyle=\"--\",\n",
    "    label=f\"Critical Value = {critical_value:.4f}\"\n",
    ")\n",
    "\n",
    "# Test statistic\n",
    "plt.axvline(\n",
    "    z_stat,\n",
    "    linestyle=\"--\",\n",
    "    label=f\"Test Statistic = {z_stat:.4f}\"\n",
    ")\n",
    "\n",
    "plt.title(\n",
    "    \"RQ2: One Tailed Z Test for Step Back Rate\"\n",
    ")\n",
    "plt.xlabel(\"Z Score\")\n",
    "plt.ylabel(\"Probability Density\")\n",
    "\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "print(f\"Alpha: {alpha}\")\n",
    "print(f\"Critical value: {critical_value:.4f}\")\n",
    "print(f\"Test statistic: {z_stat:.4f}\")"
    "def bootstrap_median_diff(a, b, n_boot=1000, seed=42):\n",
    "    \"\"\"95% CI for the difference in medians (test - control).\"\"\"\n",
    "    r = np.random.default_rng(seed)\n",
    "    a, b = a.dropna().to_numpy(), b.dropna().to_numpy()\n",
    "    diffs = np.empty(n_boot)\n",
    "    \n",
    "    for i in range(n_boot):\n",
    "        diffs[i] = (np.median(r.choice(a, len(a), replace=True))\n",
    "                    - np.median(r.choice(b, len(b), replace=True)))\n",
    "    return np.median(a) - np.median(b), np.percentile(diffs, [2.5, 97.5])\n",
    "\n",
    "\n",
    "d, (lo, hi) = bootstrap_median_diff(test[\"completion_minutes\"], control[\"completion_minutes\"])\n",
    "print(f\"Median completion time: {d:+.2f} min   95% CI [{lo:+.2f}, {hi:+.2f}]\")"
   ]
