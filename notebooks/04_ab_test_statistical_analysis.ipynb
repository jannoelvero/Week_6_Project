    "# Critical value visualization\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import norm\n",
    "\n",
    "n_test = len(test_time)\n",
    "n_control = len(control_time)\n",
    "\n",
    "# Expected U and standard deviation under H0\n",
    "mean_u = (n_test * n_control) / 2\n",
    "\n",
    "std_u = np.sqrt(\n",
    "    n_test * n_control *\n",
    "    (n_test + n_control + 1) / 12\n",
    ")\n",
    "\n",
    "# Convert U statistic to Z statistic\n",
    "z_stat = (u_stat - mean_u) / std_u\n",
    "\n",
    "alpha = 0.05\n",
    "critical_value = norm.ppf(alpha)\n",
    "\n",
    "print(f\"Alpha: {alpha}\")\n",
    "print(f\"LCV: {critical_value:.4f}\")\n",
    "print(\"UCV: Not applicable for a left-tailed test\")\n",
    "print(f\"Test statistic Z: {z_stat:.4f}\")"
