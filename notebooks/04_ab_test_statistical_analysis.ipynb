   "source": [
    "# Calculate 95% confidence interval for the difference in proportions\n",
    "\n",
    "from scipy.stats import norm\n",
    "\n",
    "difference = test_rate - control_rate\n",
    "\n",
    "standard_error = np.sqrt(\n",
    "    (test_rate * (1 - test_rate) / test_total)\n",
    "    +\n",
    "    (control_rate * (1 - control_rate) / control_total)\n",
    ")\n",
    "\n",
    "z_critical_95 = norm.ppf(0.975)\n",
    "\n",
    "ci_lower = difference - z_critical_95 * standard_error\n",
    "ci_upper = difference + z_critical_95 * standard_error\n",
    "\n",
    "print(f\"Difference in Step Back rates: {difference:.4%}\")\n",
    "print(f\"95% CI lower bound: {ci_lower:.4%}\")\n",
    "print(f\"95% CI upper bound: {ci_upper:.4%}\")"
    "sb_diff, sb_low, sb_high = proportion_diff_ci(\n",
    "    (test[\"step_back_count\"] > 0).sum(), len(test),\n",
    "    (control[\"step_back_count\"] > 0).sum(), len(control),\n",
    ")\n",
    "\n",
    "print(f\"Step Back Rate difference: {sb_diff:+.2f} pp\")\n",
    "print(f\"95% CI: [{sb_low:+.2f}, {sb_high:+.2f}] pp\")"
   ]
