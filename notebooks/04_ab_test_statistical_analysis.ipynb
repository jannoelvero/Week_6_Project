    "from statsmodels.stats.proportion import proportions_ztest\n",
    "\n",
    "# Funnel counts from the conversion analysis\n",
    "transitions = [\n",
    "    \"start → step_1\",\n",
    "    \"step_1 → step_2\",\n",
    "    \"step_2 → step_3\",\n",
    "    \"step_3 → confirm\"\n",
    "]\n",
    "\n",
    "control_converted = [20082, 18633, 17356, 15329]\n",
    "control_eligible = [23397, 20152, 18650, 17422]\n",
    "\n",
    "test_converted = [24201, 22243, 20834, 18445]\n",
    "test_eligible = [26679, 24267, 22258, 20881]\n",
    "\n",
    "# Store test results\n",
    "z_test_results = []\n",
    "\n",
    "for i in range(len(transitions)):\n",
    "    count = [\n",
    "        control_converted[i],\n",
    "        test_converted[i]\n",
    "    ]\n",
    "\n",
    "    nobs = [\n",
    "        control_eligible[i],\n",
    "        test_eligible[i]\n",
    "    ]\n",
    "\n",
    "    z_stat, p_value = proportions_ztest(count, nobs)\n",
    "\n",
    "    z_test_results.append([\n",
    "        transitions[i],\n",
    "        z_stat,\n",
    "        p_value\n",
    "    ])\n",
    "\n",
    "z_test_results"
   ]
