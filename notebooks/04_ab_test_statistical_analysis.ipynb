   "source": [
    "#  Mann Whitney U test\n",
    "\n",
    "from scipy.stats import mannwhitneyu\n",
    "\n",
    "control_navigation = client_kpi_df.loc[\n",
    "    client_kpi_df[\"Variation\"] == \"Control\",\n",
    "    \"step_back_count\"\n",
    "]\n",
    "\n",
    "test_navigation = client_kpi_df.loc[\n",
    "    client_kpi_df[\"Variation\"] == \"Test\",\n",
    "    \"step_back_count\"\n",
    "]\n",
    "\n",
    "u_stat, p_value = mannwhitneyu(\n",
    "    test_navigation,\n",
    "    control_navigation,\n",
    "    alternative=\"less\"\n",
    ")\n",
    "\n",
    "print(f\"Mann Whitney U statistic: {u_stat:.2f}\")\n",
    "print(f\"P value: {p_value:.6f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 116,
   "id": "f331074f-cb48-4a14-bc7f-d92553386907",
   "metadata": {},
   "outputs": [
