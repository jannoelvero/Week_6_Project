     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Rank biserial correlation: 0.0791\n"
     ]
    }
   ],
   "source": [
    "# Rank biserial effect size\n",
    "\n",
    "n_test = len(test_navigation)\n",
    "n_control = len(control_navigation)\n",
    "\n",
    "rank_biserial = (\n",
    "    (2 * u_stat) / (n_test * n_control)\n",
    ") - 1\n",
    "\n",
    "print(f\"Rank biserial correlation: {rank_biserial:.4f}\")"
   ]
