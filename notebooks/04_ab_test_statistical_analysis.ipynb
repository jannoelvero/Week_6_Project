   "source": [
    "# Number of clients in each group\n",
    "\n",
    "control_total = completion_summary.loc[\"Control\", \"total_clients\"]\n",
    "test_total = completion_summary.loc[\"Test\", \"total_clients\"]\n",
    "\n",
    "# Difference in completion proportions\n",
    "\n",
    "difference = p_test - p_control\n",
    "\n",
    "# Standard error\n",
    "\n",
    "standard_error = np.sqrt(\n",
    "    (p_control * (1 - p_control) / control_total)\n",
    "    + (p_test * (1 - p_test) / test_total)\n",
    ")\n",
    "\n",
    "# 95% confidence interval\n",
    "\n",
    "margin_of_error = 1.96 * standard_error\n",
    "\n",
    "ci_lower = difference - margin_of_error\n",
    "ci_upper = difference + margin_of_error\n",
    "\n",
    "print(\n",
    "    f\"Completion rate difference: \"\n",
    "    f\"{difference * 100:.2f} percentage points\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"95% CI: \"\n",
    "    f\"{ci_lower * 100:.2f} to \"\n",
    "    f\"{ci_upper * 100:.2f} percentage points\"\n",
    ")\n"
