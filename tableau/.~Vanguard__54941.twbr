      <aliases enabled='yes' />
      <column caption='Start to Step 1 Conversion' datatype='real' name='[Calculation_1893878419312642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [process_step] = &quot;step_1&quot;&#10;    THEN [client_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [process_step] = &quot;start&quot;&#10;    THEN [client_id]&#10;    END&#10;)' />
      </column>
      <column caption='Step 1 to Step 2 Conversion' datatype='real' name='[Calculation_1893878419484675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([process_step] = &quot;step_2&quot;, 1, 0))&#10;/&#10;SUM(IIF([process_step] = &quot;step_1&quot;, 1, 0))' />
      </column>
      <column caption='Step 2 to Step 3 Conversion' datatype='real' name='[Calculation_1893878419615748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([process_step] = &quot;step_3&quot;, 1, 0))&#10;/&#10;SUM(IIF([process_step] = &quot;step_2&quot;, 1, 0))' />
      </column>
      <column caption='Step 3 to Confirm Conversion' datatype='real' name='[Calculation_1893878419738629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([process_step] = &quot;confirm&quot;, 1, 0))&#10;/&#10;SUM(IIF([process_step] = &quot;step_3&quot;, 1, 0))' />
      </column>
