        <zone flipboard-zone-id='5' forceUpdate='true' h='30498' hidden='true' id='6' story-point-id='1' type-v2='text' w='99311' x='295' y='18465'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='30'>Transforming Vanguard’s Digital Client Experience</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='16'>Does the Redesigned Experience Deliver Better Client Outcomes?</run>
            <run>Æ&#10;&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>by</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Lara, Jan, and Paul</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Business Analysts</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='41701' hidden='true' id='7' story-point-id='2' type-v2='text' w='98524' x='1181' y='15664'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='60'>90%</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book'>of client contact with 20 million clients is digital</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book'>Vanguard introduced a redesigned digital experience to improve how clients navigate and complete an important online process. The redesign was tested against the existing experience through an A/B experiment, comparing </run>
            <run bold='true' fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book'>Control</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book'> and </run>
            <run bold='true' fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book'>Test</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book'> groups.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='10477' hidden='true' id='8' story-point-id='2' type-v2='text' w='25787' x='35630' y='62656'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='32'>$4.2T</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book' fontsize='13'>under management, Feb 2017</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='40975' hidden='true' id='10' story-point-id='3' type-v2='text' w='86811' x='6004' y='17635'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='24'>From a New Design to a Measurable Business Outcome</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Purpose</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book'>Evaluate whether the redesigned digital experience improves client outcomes while maintaining a clear and efficient customer journey.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5498' hidden='true' id='11' story-point-id='4' type-v2='text' w='81299' x='8661' y='19191'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='24'>But What Were Clients Actually Experiencing?</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='38071' hidden='true' id='14' story-point-id='6' type-v2='text' w='74114' x='10925' y='31846'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='28'>Does the Redesigned Digital Experience Actually Solve the Customer Problem?</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='20'>And is it ready for deployment?</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4979' hidden='true' id='15' story-point-id='13' type-v2='text' w='90256' x='4331' y='21266'>
          <formatted-text>
            <run bold='true' fontcolor='#666666' fontname='Benton Sans Book' fontsize='24'>Should Vanguard Deploy the New Digital Experience?</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='50311' hidden='true' id='16' story-point-id='13' type-v2='text' w='39370' x='3642' y='30498'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='48'>1</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='18'>Deploy the New Design</run>
