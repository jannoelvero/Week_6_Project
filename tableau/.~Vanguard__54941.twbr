            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>Rationale:</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Higher completion</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Faster completion</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Strong initial funnel improvement</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Monitor and correct navigation friction after deployment</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='50622' hidden='true' id='17' story-point-id='13' type-v2='text' w='42028' x='51575' y='29979'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='48'>2</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='18'>Optimize Before Full Deployment</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>Rationale:</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Preserve successful Test elements</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Address Start to Step 1 friction</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Reduce backward navigation</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='15'>-Validate improvements before full rollout</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='9751' hidden='true' id='18' story-point-id='14' type-v2='text' w='85827' x='6398' y='19502'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='31'>Deploy — after fixing the first screen</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='24481' id='19' story-point-id='15' type-v2='text' w='57677' x='23130' y='29668'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontsize='40'>Thank you!</run>
            <run>&#10;&#10;QR Scan for company email??&#10;&#10;</run>
            <run fontcolor='#898989' fontname='Menlo' fontsize='12'>github.com/jannoelvero/Week_6_Project</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='7884' hidden='true' id='20' story-point-id='2' type-v2='text' w='24606' x='-394' y='64108'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='32'>10M</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book' fontsize='13'>phone calls in 2016</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='7884' hidden='true' id='21' story-point-id='2' type-v2='text' w='24902' x='73130' y='64212'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='32'>30+ min</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book' fontsize='13'>phone wait times, March 2017</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='8817' hidden='true' id='22' story-point-id='2' type-v2='text' w='73228' x='295' y='93361'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#b4b4b4' fontname='Benton Sans Book' fontsize='9'>Sources: InvestmentNews, 16 Feb 2017 · Philadelphia Inquirer, 31 Mar 2017 · Vanguard announcement via VISTA.Today, Nov 2016</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='7780' hidden='true' id='23' story-point-id='3' type-v2='text' w='22638' x='6201' y='56432'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='16'>Completion - RQ1</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='13'>Did more clients finish?</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='6846' hidden='true' id='24' story-point-id='3' type-v2='text' w='19587' x='51476' y='56328'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='16'>Efficiency - RQ3</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='13'>Did they finish faster?</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4876' hidden='true' id='25' story-point-id='3' type-v2='text' w='28543' x='6004' y='76556'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='16' lmargin='600' rmargin='600'>Navigation - RQ2</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='13' lmargin='600' rmargin='600'>Did they move backwards more?</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='6535' hidden='true' id='26' story-point-id='3' type-v2='text' w='27657' x='51181' y='74689'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='16'>Funnel - RQ5</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='13'>Where in the process did it change?</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='28423' hidden='true' id='27' story-point-id='4' type-v2='text' w='38189' x='8858' y='28112'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='18' italic='true'>&quot;I use the Vanguard funds while holding my nose at the web-site and trying to avoid the phone lines as much as possible.&quot;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontcolor='#898989' fontname='Benton Sans Book' fontsize='12'>rob, Bogleheads forum, September 2014</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='3320' hidden='true' id='28' story-point-id='4' type-v2='text' w='66043' x='34449' y='95228'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#898989' fontname='Benton Sans Book' fontsize='9'>Source: Bogleheads forum. A public forum is self-selected, so these comments show a mechanism, not its frequency</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='28216' hidden='true' id='29' story-point-id='4' type-v2='text' w='35630' x='53937' y='29357'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='18' italic='true'>&quot;It requires way too much digging to find the most basic info, if you can find it at all.&quot;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontcolor='#898989' fontname='Benton Sans Book' fontsize='11'>dhectorg, November 2016</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='13797' hidden='true' id='30' story-point-id='4' type-v2='text' w='9843' x='591' y='26037'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='72'>“</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='14004' hidden='true' id='31' story-point-id='4' type-v2='text' w='9843' x='86319' y='81846'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='72'>”</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='25519' hidden='true' id='32' story-point-id='4' type-v2='text' w='84547' x='7776' y='61411'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='22' italic='true'>&quot;The site is poorly designed… That combined with customer service issues may lead me to take my Vanguard funds elsewhere.&quot;</run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontcolor='#898989' fontname='Benton Sans Book' fontsize='11'>michaeljc70, November 2016</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4979' hidden='true' id='33' story-point-id='13' type-v2='text' w='73130' x='13091' y='86411'>
          <formatted-text>
            <run fontcolor='#96323c' fontname='Benton Sans Book' fontsize='16' italic='true'>Both are defensible. The evidence points to one.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='17427' hidden='true' id='34' story-point-id='14' type-v2='text' w='22835' x='8661' y='34025'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='26'>+3.71 pp</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book' fontsize='12'>completion rate</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='8402' hidden='true' id='35' story-point-id='14' type-v2='text' w='78740' x='13583' y='50415'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#666666' fontname='Benton Sans Book' fontsize='16'>Both the gain and the cost are at Start → Step 1. Fix that screen, then roll out.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='3734' hidden='true' id='36' story-point-id='14' type-v2='text' w='59252' x='21358' y='61929'>
          <formatted-text>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='12'>Completion gain holds after Holm–Bonferroni correction for multiple testing.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='10685' hidden='true' id='37' story-point-id='14' type-v2='text' w='18898' x='40846' y='37033'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='26'>34 sec</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book' fontsize='12'>faster per client</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='8506' hidden='true' id='38' story-point-id='14' type-v2='text' w='21063' x='68209' y='38589'>
          <formatted-text>
            <run bold='true' fontcolor='#96323c' fontname='Benton Sans Book' fontsize='26'>+7.31 pp</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontname='Benton Sans Book'>step back rate</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='3112' id='39' story-point-id='15' type-v2='text' w='23917' x='39567' y='78838'>
          <formatted-text>
            <run fontcolor='#666666' fontname='Benton Sans Book'>Lara · Jan · Paul</run>
          </formatted-text>
